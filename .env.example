# --- Propriétaires (chiffres uniquement, avec indicatif pays, sans +) ---
MOTHER_NUMBER=237692798136
SECOND_OWNER_NUMBER=
UPDATE_BY=L. Lycoris

# --- Gemini : 6 clés séparées par des virgules (rotation automatique) ---
GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6
GEMINI_MODEL=gemini-2.5-flash

# --- Firestore ---
# Le plus simple : le contenu de ton fichier JSON Firebase encodé en base64 (commande: base64 -w0 serviceAccount.json)
FIREBASE_SERVICE_ACCOUNT_JSON=
# (alternative: un fichier ./serviceAccount.json à la place)
# FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json

# --- API du site de connexion QR ---
PORT=3000
# Seulement si le site est hébergé AILLEURS (Lovable...) : son adresse. Sinon laisse vide.
FRONTEND_ORIGIN=
ADMIN_PASSWORD=change-moi-avec-un-long-mot-de-passe
JWT_SECRET=change-moi-chaine-aleatoire-de-64-caracteres
